# ===================================================
# SCHOOLRIDE LK — ENVIRONMENT CONFIGURATION
# ===================================================

# Server and Port Configuration
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL / Neon compatible)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schoolride_lk?schema=public"
# DIRECT_URL is used by Prisma for direct migrations when using connection poolers like PgBouncer
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/schoolride_lk?schema=public"

# Authentication & Security
# Generate secure random keys in production (e.g., openssl rand -base64 32)
JWT_ACCESS_SECRET="dev-access-secret-schoolride-lk-min-32-chars-long!"
JWT_REFRESH_SECRET="dev-refresh-secret-schoolride-lk-min-32-chars-long!"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
COOKIE_SECURE=false

# Field-Level Encryption (for sensitive NIC or driver documents)
ENCRYPTION_KEY="01234567890123456789012345678901"

# Object Storage (S3 / Cloudflare R2 / Supabase Storage compatible)
STORAGE_PROVIDER=supabase
STORAGE_ENDPOINT=https://<project-ref>.supabase.co
STORAGE_REGION=auto
STORAGE_BUCKET=schoolride-documents
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
LOCAL_UPLOAD_DIR=./uploads

# Supabase Integration
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<supabase-anon-or-publishable-key>"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<supabase-publishable-key>"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_KEY="<supabase-key>"

# Transactional Email (Resend or SMTP)
EMAIL_PROVIDER=mock
EMAIL_FROM="SchoolRide LK <notifications@schoolride.lk>"
RESEND_API_KEY=

# Sri Lanka SMS Gateway (e.g. Notify.lk or Mobitel mCall)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=SchoolRide

# Map Configuration (OpenStreetMap / CartoDB / Mapbox)
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors &copy; <a href='https://carto.com/attributions'>CARTO</a>"

# Initial Admin Seed Credentials
ADMIN_SEED_EMAIL="admin@schoolride.lk"
ADMIN_SEED_PASSWORD="AdminPassword123!"
ADMIN_SEED_NAME="Platform Administrator"
ADMIN_SEED_PHONE="+94771234567"
