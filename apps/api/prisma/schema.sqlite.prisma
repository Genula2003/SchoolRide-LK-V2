generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String
  fullName      String
  phone         String        @unique
  role          String        @default("PARENT") // PARENT, DRIVER, ADMIN
  status        String        @default("ACTIVE") // ACTIVE, PENDING_VERIFICATION, SUSPENDED, DEACTIVATED
  district      String?
  city          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  parentProfile     ParentProfile?
  driverProfile     DriverProfile?
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  auditLogs         AuditLog[]         @relation("ActorAuditLogs")
  createdComplaints Complaint[]        @relation("ComplaintCreator")
  targetedComplaints Complaint[]       @relation("ComplaintTarget")
  resolvedComplaints Complaint[]       @relation("ComplaintResolver")
  bookingHistories  BookingStatusHistory[]

  @@index([email])
  @@index([role, status])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model ParentProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  address               String?
  city                  String?
  district              String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  children              Child[]
  bookings              BookingRequest[]
  reviews               Review[]

  @@index([userId])
}

model Child {
  id               String   @id @default(uuid())
  parentId         String
  parent           ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  dateOfBirth      String
  gender           String
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id])
  grade            String
  pickupAddress    String
  pickupLatitude   Float
  pickupLongitude  Float
  dropoffAddress   String
  dropoffLatitude  Float
  dropoffLongitude Float
  specialNotes     String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  bookings         BookingRequest[]
  ridePassengers   RideSessionPassenger[]

  @@index([parentId])
  @@index([schoolId])
}

model School {
  id            String   @id @default(uuid())
  name          String   @unique
  district      String
  city          String
  address       String
  latitude      Float
  longitude     Float
  contactNumber String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  children      Child[]
  driverCoverages DriverSchoolCoverage[]

  @@index([district])
  @@index([name])
}

model DriverProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  nicNumber          String             @unique
  licenseNumber      String             @unique
  experienceYears    Int                @default(1)
  bio                String?
  ratingAverage      Float              @default(5.0)
  ratingCount        Int                @default(0)
  verificationStatus String             @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  verifiedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  vehicles           Vehicle[]
  documents          DriverDocument[]
  serviceAreas       ServiceArea[]
  schoolCoverages    DriverSchoolCoverage[]
  bookings           BookingRequest[]
  rideSessions       RideSession[]
  reviews            Review[]

  @@index([verificationStatus])
  @@index([userId])
}

model DriverDocument {
  id              String   @id @default(uuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  documentType    String   // NIC_FRONT, NIC_BACK, DRIVING_LICENSE_FRONT, etc.
  fileKey         String
  fileName        String
  fileSize        Int
  mimeType        String
  isVerified      Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([driverProfileId])
}

model Vehicle {
  id                   String   @id @default(uuid())
  driverProfileId      String
  driverProfile        DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  vehicleType          String   @default("VAN") // VAN, MINI_BUS, CAR, TUK_TUK
  make                 String
  model                String
  year                 Int
  licensePlate         String   @unique
  capacity             Int
  isAirConditioned     Boolean  @default(false)
  hasEmergencyExit     Boolean  @default(true)
  hasFireExtinguisher  Boolean  @default(true)
  hasFirstAidKit       Boolean  @default(true)
  insuranceExpiry      String
  revenueLicenseExpiry String
  verificationStatus   String   @default("PENDING")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  documents            VehicleDocument[]
  bookings             BookingRequest[]
  rideSessions         RideSession[]

  @@index([driverProfileId])
  @@index([verificationStatus])
}

model VehicleDocument {
  id           String   @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  documentType String   // REVENUE_LICENSE, VEHICLE_INSURANCE, FITNESS_CERTIFICATE
  fileKey      String
  fileName     String
  fileSize     Int
  mimeType     String
  isVerified   Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([vehicleId])
}

model ServiceArea {
  id                   String        @id @default(uuid())
  driverProfileId      String
  driverProfile        DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  district             String
  city                 String
  operatingAreas       String        @default("[]") // JSON string of cities
  monthlyRateMinorUnits Int          @default(1500000)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([driverProfileId])
  @@index([district])
}

model DriverSchoolCoverage {
  id              String        @id @default(uuid())
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([driverProfileId, schoolId])
  @@index([driverProfileId])
  @@index([schoolId])
}

model BookingRequest {
  id                   String        @id @default(uuid())
  parentId             String
  parent               ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  childId              String
  child                Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  driverProfileId      String
  driverProfile        DriverProfile @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  vehicleId            String
  vehicle              Vehicle       @relation(fields: [vehicleId], references: [id])
  pickupAddress        String
  pickupLatitude       Float
  pickupLongitude      Float
  dropoffAddress       String
  dropoffLatitude      Float
  dropoffLongitude     Float
  pickupTimeMorning    String
  dropoffTimeAfternoon String
  startDate            String
  monthlyFeeMinorUnits Int
  status               String        @default("PENDING") // PENDING, ACCEPTED, ACTIVE, COMPLETED, REJECTED, CANCELLED
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  statusHistory        BookingStatusHistory[]
  ridePassengers       RideSessionPassenger[]
  review               Review?
  complaints           Complaint[]

  @@index([parentId])
  @@index([driverProfileId])
  @@index([childId])
  @@index([status])
}

model BookingStatusHistory {
  id              String        @id @default(uuid())
  bookingId       String
  booking         BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedByUserId String
  changedByUser   User          @relation(fields: [changedByUserId], references: [id])
  reason          String?
  createdAt       DateTime      @default(now())

  @@index([bookingId])
}

model RideSession {
  id                   String        @id @default(uuid())
  driverProfileId      String
  driverProfile        DriverProfile @relation(fields: [driverProfileId], references: [id])
  vehicleId            String
  vehicle              Vehicle       @relation(fields: [vehicleId], references: [id])
  routeName            String
  status               String        @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  startedAt            DateTime?
  endedAt              DateTime?
  currentLatitude      Float?
  currentLongitude     Float?
  lastLocationUpdateAt DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  passengers           RideSessionPassenger[]
  locationUpdates      RideLocationUpdate[]

  @@index([driverProfileId])
  @@index([status])
}

model RideSessionPassenger {
  id            String                @id @default(uuid())
  rideSessionId String
  rideSession   RideSession           @relation(fields: [rideSessionId], references: [id], onDelete: Cascade)
  bookingId     String
  booking       BookingRequest        @relation(fields: [bookingId], references: [id])
  childId       String
  child         Child                 @relation(fields: [childId], references: [id])
  pickupStatus  String                @default("SCHEDULED") // SCHEDULED, PICKED_UP, DROPPED_OFF, ABSENT
  pickupTime    DateTime?
  dropoffTime   DateTime?
  notes         String?

  @@index([rideSessionId])
  @@index([bookingId])
}

model RideLocationUpdate {
  id            String      @id @default(uuid())
  rideSessionId String
  rideSession   RideSession @relation(fields: [rideSessionId], references: [id], onDelete: Cascade)
  latitude      Float
  longitude     Float
  speed         Float?
  heading       Float?
  timestamp     DateTime    @default(now())

  @@index([rideSessionId, timestamp])
}

model Review {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  booking         BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  parentId        String
  parent          ParentProfile @relation(fields: [parentId], references: [id])
  driverProfileId String
  driverProfile   DriverProfile @relation(fields: [driverProfileId], references: [id])
  rating          Int
  comment         String
  isPublic        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([driverProfileId])
  @@index([parentId])
}

model Complaint {
  id              String            @id @default(uuid())
  createdByUserId String
  createdByUser   User              @relation("ComplaintCreator", fields: [createdByUserId], references: [id])
  bookingId       String?
  booking         BookingRequest?   @relation(fields: [bookingId], references: [id])
  targetUserId    String?
  targetUser      User?             @relation("ComplaintTarget", fields: [targetUserId], references: [id])
  category        String            @default("SAFETY")
  title           String
  description     String
  status          String            @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, DISMISSED
  adminNotes      String?
  resolvedAt      DateTime?
  resolvedByUserId String?
  resolvedByUser  User?             @relation("ComplaintResolver", fields: [resolvedByUserId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([createdByUserId])
  @@index([status])
  @@index([targetUserId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String           @default("SYSTEM")
  read      Boolean          @default(false)
  dataJson  String?
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorUserId  String?
  actorUser    User?    @relation("ActorAuditLogs", fields: [actorUserId], references: [id])
  action       String
  entityType   String
  entityId     String?
  ipAddress    String?
  userAgent    String?
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([entityType, entityId])
}
